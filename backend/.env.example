# PostgreSQL deployment is the default. Copy to .env; never commit real keys.
DATABASE_URL=postgresql+psycopg://nexus:nexus_local@127.0.0.1:55432/nexus
NEXUS_SEED_DEMO=true
NEXUS_DEMO_MODE=true
NEXUS_SECURE_COOKIE=false
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional local observability. Empty endpoint keeps traces in-process only.
NEXUS_OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Demo-only failure before understand; leave empty normally.
NEXUS_OBS_FAULT_NODE=
